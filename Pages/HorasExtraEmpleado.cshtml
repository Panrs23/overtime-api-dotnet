@page

<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Horas Extra Empleado</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
</head>

<body class="bg-light">

<nav class="navbar navbar-expand-lg navbar-dark bg-primary">

    <div class="container d-flex align-items-center">

        <span class="navbar-brand mb-0">
            Overtime API .NET
        </span>

        <a class="btn btn-outline-light btn-sm ms-auto me-3"
           href="/Empleado">
            Volver
        </a>
        <a class="btn btn-outline-light btn-sm me-3" href="/Flujo">Ver flujo</a>

        <span id="usuarioTexto" class="text-white me-2"></span>

        <button class="btn btn-sm btn-outline-danger"
                onclick="logout()">
            Cerrar sesión
        </button>

    </div>

</nav>

<main class="container py-4">

    <div id="mensaje"
         class="alert d-none"
         role="alert">
    </div>

    <section class="row g-4">

        <div class="col-lg-5">

            <div class="card shadow-sm">

                <div class="card-header fw-semibold">
                    Crear solicitud de horas extra
                </div>

                <div class="card-body">

                    <form id="solicitudForm" class="row g-3">

                        <div class="col-12">
                            <label class="form-label">Fecha</label>

                            <input id="solicitudFecha"
                                   type="date"
                                   class="form-control"
                                   required>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Horas</label>

                            <input id="solicitudHoras"
                                   type="number"
                                   min="0.5"
                                   step="0.5"
                                   class="form-control"
                                   required>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Motivo</label>

                            <textarea id="solicitudMotivo"
                                      class="form-control"
                                      rows="4"
                                      required>
                            </textarea>
                        </div>

                        <div class="col-12">
                            <button class="btn btn-success w-100"
                                    type="submit">
                                Guardar solicitud
                            </button>
                        </div>

                    </form>

                </div>

            </div>

        </div>

        <div class="col-lg-7">

            <div class="card shadow-sm">

                <div class="card-header d-flex justify-content-between align-items-center">

                    <span class="fw-semibold">
                        Mis solicitudes
                    </span>

                    <button class="btn btn-sm btn-outline-primary"
                            onclick="cargarSolicitudes()">
                        Actualizar
                    </button>
                    

                </div>

                <div class="card-body table-responsive">

                    <table class="table table-sm align-middle">

                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Fecha</th>
                                <th>Horas</th>
                                <th>Estado</th>
                            </tr>
                        </thead>

                        <tbody id="solicitudesTabla"></tbody>

                    </table>

                </div>

            </div>

        </div>

    </section>

</main>

<script>

const api = '';

function mostrarMensaje(texto, tipo = 'success') {

    const mensaje = document.getElementById('mensaje');

    mensaje.className = `alert alert-${tipo}`;
    mensaje.textContent = texto;

    setTimeout(() => {
        mensaje.className = 'alert d-none';
    }, 3500);
}

function logout() {
    localStorage.removeItem('usuario');
    window.location.href = '/Login';
}

function cargarUsuarioLogueado() {

    const usuario = localStorage.getItem("usuario");

    if (!usuario) {
        window.location.href = "/Login";
        return;
    }

    const usuarioObj = JSON.parse(usuario);

    document.getElementById("usuarioTexto").innerText =
        `Sesión iniciada como: ${usuarioObj.nombre} (${usuarioObj.rol})`;
}

async function cargarSolicitudes() {

    const usuario = JSON.parse(localStorage.getItem("usuario"));

    const response = await fetch(`${api}/api/horas-extra`);

    const solicitudes = await response.json();

    const solicitudesUsuario = solicitudes.filter(
        s => s.empleadoNombre.toLowerCase() === usuario.nombre.toLowerCase()
    );

    document.getElementById('solicitudesTabla').innerHTML =
        solicitudesUsuario.map(s => `
            <tr>
                <td>${s.id}</td>
                <td>${s.fecha}</td>
                <td>${s.horas}</td>
                <td>${s.estado}</td>
            </tr>
        `).join('');
}

document.getElementById('solicitudForm')
.addEventListener('submit', async event => {

    event.preventDefault();

    const usuario = JSON.parse(localStorage.getItem("usuario"));

    const empleadosResponse = await fetch(`${api}/api/empleados`);
    const empleados = await empleadosResponse.json();

    const empleado = empleados.find(
        e => e.nombre.toLowerCase() === usuario.nombre.toLowerCase()
    );

    if (!empleado) {
        mostrarMensaje('No existe empleado asociado', 'danger');
        return;
    }

    await fetch(`${api}/api/horas-extra`, {

        method: 'POST',

        headers: {
            'Content-Type': 'application/json'
        },

        body: JSON.stringify({
            empleadoId: empleado.id,
            fecha: solicitudFecha.value,
            horas: Number(solicitudHoras.value),
            motivo: solicitudMotivo.value
        })
    });

    event.target.reset();

    mostrarMensaje('Solicitud creada');

    await cargarSolicitudes();
});

cargarUsuarioLogueado();
cargarSolicitudes();

</script>

</body>
</html>