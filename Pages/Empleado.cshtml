@page

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Panel Empleado</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
</head>

<body class="bg-light">

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Panel del Empleado</h2>
            <p class="text-muted mb-0">
                Bienvenido al sistema de gestión de horas extra
            </p>
        </div>

        <a href="/Login" class="btn btn-outline-danger">
            Cerrar sesión
        </a>
    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-header bg-primary text-white">
            Información Personal
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <strong>ID Usuario</strong>
                    <p class="mb-0" id="idUsuario">Cargando...</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Nombre</strong>
                    <p class="mb-0" id="nombre">Cargando...</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Correo</strong>
                    <p class="mb-0" id="correo">Cargando...</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Rol</strong>
                    <p class="mb-0" id="rol">Cargando...</p>
                </div>

            </div>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-header">
            Acciones disponibles
        </div>

        <div class="card-body d-flex gap-3 flex-wrap">

            <button class="btn btn-outline-primary">
                Modificar Datos
            </button>

            <a id="btnHorasExtra" href="/HorasExtraEmpleado" class="btn btn-success">
                Ingresar a Horas Extras
            </a>
            <a href="/Flujo" class="btn btn-outline-secondary">
                Ver flujo del proceso
            </a>


        </div>
        

    </div>

</div>

<script>
function cargarDatosEmpleado() {

    const usuarioGuardado = localStorage.getItem("usuario");

    if (!usuarioGuardado) {
        window.location.href = "/Login";
        return;
    }

    const usuario = JSON.parse(usuarioGuardado);
    const btnHorasExtra = document.getElementById("btnHorasExtra");



    document.getElementById("idUsuario").textContent = usuario.id;
    document.getElementById("nombre").textContent = usuario.nombre;
    document.getElementById("correo").textContent = usuario.correo;
    document.getElementById("rol").textContent = usuario.rol;

    if (usuario.rol.toLowerCase() === "admin") {
    btnHorasExtra.href = "/";
} else {
    btnHorasExtra.href = "/HorasExtraEmpleado";
}
}

cargarDatosEmpleado();
</script>

</body>
</html>