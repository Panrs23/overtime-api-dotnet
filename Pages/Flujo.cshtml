@page

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Flujo Horas Extra</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>

    <style>
        .flow-container {
            min-height: 70vh;
            background: #f8fafc;
            border: 1px solid #dee2e6;
            border-radius: 16px;
            padding: 40px;
            position: relative;
        }

        .flow-card {
            background: white;
            border-radius: 14px;
            padding: 20px;
            box-shadow: 0 4px 14px rgba(0,0,0,0.08);
            border-left: 6px solid #0d6efd;
            min-height: 120px;
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }

        .flow-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 28px rgba(0,0,0,0.18);
        }

        .flow-card.success {
            border-left-color: #198754;
        }

        .flow-card.warning {
            border-left-color: #ffc107;
        }

        .flow-card.danger {
            border-left-color: #dc3545;
        }

        .arrow {
            font-size: 32px;
            color: #6c757d;
            text-align: center;
            margin: 15px 0;
            animation: arrowPulse 1.2s infinite;
        }

        @@keyframes arrowPulse {
            0% {
                opacity: 0.3;
                transform: translateY(-4px);
            }

            50% {
                opacity: 1;
                transform: translateY(4px);
            }

            100% {
                opacity: 0.3;
                transform: translateY(-4px);
            }
        }

        .status-badge {
            font-size: 13px;
        }

        .mermaid {
            text-align: center;
        }

        .pulse-warning {
            animation: warningPulse 1.5s infinite;
        }

        @@keyframes warningPulse {
            0% {
                box-shadow: 0 0 0 0 rgba(255, 193, 7, 0.7);
            }

            70% {
                box-shadow: 0 0 0 18px rgba(255, 193, 7, 0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(255, 193, 7, 0);
            }
        }

        .live-dot {
            width: 10px;
            height: 10px;
            background: #00c853;
            border-radius: 50%;
            display: inline-block;
            margin-right: 8px;
            animation: livePulse 1s infinite;
        }

        @@keyframes livePulse {
            0% {
                transform: scale(1);
                opacity: 0.5;
            }

            50% {
                transform: scale(1.4);
                opacity: 1;
            }

            100% {
                transform: scale(1);
                opacity: 0.5;
            }
        }
    </style>
</head>

<body class="bg-light">

<nav class="navbar navbar-expand-lg navbar-dark bg-primary">

    <div class="container d-flex align-items-center">

        <span class="navbar-brand mb-0">
            Overtime API .NET
        </span>

        <a href="/Empleado"
           class="btn btn-outline-light btn-sm ms-auto me-3">
            Volver al panel
        </a>

        <span id="usuarioTexto"
              class="text-white me-3">
        </span>

        <button class="btn btn-sm btn-outline-danger"
                onclick="logout()">
            Cerrar sesión
        </button>

    </div>

</nav>

<main class="container py-4">

    <div class="mb-4 d-flex justify-content-between align-items-center">

        <div>
            <h3 class="mb-1">
                Flujo del proceso de horas extra
            </h3>

            <p class="text-muted mb-0">
                Representación visual del ciclo de solicitud,
                revisión y aprobación.
            </p>
        </div>

        <div class="badge bg-dark p-2 fs-6">
            <span class="live-dot"></span>
            Tiempo real
        </div>

    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-header fw-semibold">
            Mapa visual del proceso
        </div>

        <div class="card-body">

<pre class="mermaid">
flowchart LR

    A[Empleado]
    --> B[Crear solicitud]

    B --> C[Pendiente]

    C --> D[Revision Admin]

    D --> E[Aprobada]
    D --> F[Rechazada]

    C:::warning
    E:::success
    F:::danger

    classDef warning fill:#fff3cd,stroke:#ffc107,color:#664d03;
    classDef success fill:#d1e7dd,stroke:#198754,color:#0f5132;
    classDef danger fill:#f8d7da,stroke:#dc3545,color:#842029;
</pre>

        </div>

    </div>

    <div class="flow-container">

        <div class="row justify-content-center">

            <div class="col-md-5">

                <div class="flow-card">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <h5>
                                1. Empleado
                            </h5>

                            <p class="text-muted mb-0">
                                El trabajador inicia sesión
                                y accede a su panel personal.
                            </p>

                        </div>

                        <span id="totalSolicitudes"
                              class="badge bg-primary status-badge">
                            0 solicitudes
                        </span>

                    </div>

                </div>

            </div>

        </div>

        <div class="arrow">↓</div>

        <div class="row justify-content-center">

            <div class="col-md-5">

                <div class="flow-card">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <h5>
                                2. Solicitud de horas extra
                            </h5>

                            <p class="text-muted mb-0">
                                El empleado registra fecha,
                                cantidad de horas y motivo.
                            </p>

                        </div>

                        <span class="badge bg-info text-dark status-badge">
                            Registro
                        </span>

                    </div>

                </div>

            </div>

        </div>

        <div class="arrow">↓</div>

        <div class="row justify-content-center">

            <div class="col-md-5">

                <div id="cardPendientes" class="flow-card warning">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <h5>
                                3. Solicitud pendiente
                            </h5>

                            <p class="text-muted mb-0">
                                La solicitud queda disponible
                                para revisión administrativa.
                            </p>

                        </div>

                        <span id="totalPendientes"
                              class="badge bg-warning text-dark status-badge">
                            0 pendientes
                        </span>

                    </div>

                </div>

            </div>

        </div>

        <div class="arrow">↓</div>

        <div class="row justify-content-center">

            <div class="col-md-5">

                <div class="flow-card">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <h5>
                                4. Revisión del administrador
                            </h5>

                            <p class="text-muted mb-0">
                                El administrador evalúa la solicitud
                                y decide aprobar o rechazar.
                            </p>

                        </div>

                        <span class="badge bg-secondary status-badge">
                            Validación
                        </span>

                    </div>

                </div>

            </div>

        </div>

        <div class="arrow">↓</div>

        <div class="row g-4 justify-content-center">

            <div class="col-md-4">

                <div class="flow-card success">

                    <h5>
                        5A. Solicitud aprobada
                    </h5>

                    <p class="text-muted mb-0">
                        Las horas extra quedan registradas
                        como aprobadas.
                    </p>

                    <span id="totalAprobadas"
                          class="badge bg-success mt-3">
                        0 aprobadas
                    </span>

                </div>

            </div>

            <div class="col-md-4">

                <div class="flow-card danger">

                    <h5>
                        5B. Solicitud rechazada
                    </h5>

                    <p class="text-muted mb-0">
                        La solicitud queda marcada como rechazada.
                    </p>

                    <span id="totalRechazadas"
                          class="badge bg-danger mt-3">
                        0 rechazadas
                    </span>

                </div>

            </div>

        </div>

    </div>

</main>

<script>
mermaid.initialize({
    startOnLoad: true,
    theme: "default"
});

function cargarUsuario() {

    const usuarioGuardado = localStorage.getItem("usuario");

    if (!usuarioGuardado) {
        window.location.href = "/Login";
        return;
    }

    const usuario = JSON.parse(usuarioGuardado);

    document.getElementById("usuarioTexto").innerText =
        `${usuario.nombre} (${usuario.rol})`;
}

function logout() {

    localStorage.removeItem("usuario");
    window.location.href = "/Login";
}

async function cargarEstadoFlujo() {

    const response = await fetch("/api/horas-extra");

    if (!response.ok) {
        console.error("No se pudieron cargar las solicitudes");
        return;
    }

    const solicitudes = await response.json();

    const pendientes =
        solicitudes.filter(s => s.estado === "PENDIENTE").length;

    const aprobadas =
        solicitudes.filter(s => s.estado === "APROBADA").length;

    const rechazadas =
        solicitudes.filter(s => s.estado === "RECHAZADA").length;

    const cardPendientes =
        document.getElementById("cardPendientes");

    if (pendientes > 0) {
        cardPendientes.classList.add("pulse-warning");
    }
    else {
        cardPendientes.classList.remove("pulse-warning");
    }

    document.getElementById("totalSolicitudes").textContent =
        `${solicitudes.length} solicitudes`;

    document.getElementById("totalPendientes").textContent =
        `${pendientes} pendientes`;

    document.getElementById("totalAprobadas").textContent =
        `${aprobadas} aprobadas`;

    document.getElementById("totalRechazadas").textContent =
        `${rechazadas} rechazadas`;
}

cargarUsuario();
cargarEstadoFlujo();

setInterval(() => {
    cargarEstadoFlujo();
}, 5000);
</script>

</body>
</html>